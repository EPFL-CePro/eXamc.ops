# Managed by Ansible - do not edit by hand.
# Only what differs from the defaults in compose/compose.base.yml.
# Secrets are not here: they are files in SECRETS_DIR.
{% set port = (':' ~ caddy_port) if caddy_port is defined else '' %}
ENV={{ env }}

# App user (owns private_media and the secrets; Django runs as it)
UID={{ app_uid }}
GID={{ app_gid | default(app_uid) }}

# Host paths used by Compose
SECRETS_DIR={{ secrets_dir }}
PRIVATE_MEDIA_DIR={{ media_dir }}
{% if django_image_tag is defined %}

# Images (staging/prod pull them; dev builds locally)
DJANGO_IMAGE_TAG={{ django_image_tag }}
FE_ARTIFACTS_IMAGE_TAG={{ fe_artifacts_image_tag | default(django_image_tag) }}
{% endif %}

# Site: every name/IP the app answers on
SITE_ADDRESS={{ site_hosts | map('regex_replace', '$', port) | join(', ') }}
CADDY_TLS_MODE={{ caddy_tls_mode | default('internal') }}
{% if caddy_port is defined %}
CADDY_PORT={{ caddy_port }}
{% endif %}
ALLOWED_HOSTS={{ (site_hosts + ['localhost', '127.0.0.1']) | unique | join(',') }}
CSRF_TRUSTED_ORIGINS={{ site_hosts | map('regex_replace', '^(.*)$', 'https://\\1' ~ port) | join(',') }}
{% if mysql_database is defined %}

# Database name, when it differs from the default (examc)
MYSQL_DATABASE={{ mysql_database }}
{% endif %}
{% if debug | default(false) or celery_task_always_eager | default(false) %}

# Dev only
{% endif %}
{% if debug | default(false) %}
DEBUG=1
{% endif %}
{% if celery_task_always_eager | default(false) %}
CELERY_TASK_ALWAYS_EAGER=True
{% endif %}
